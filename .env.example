# ===========================================================================
# AI RAG Platform - environment template
# Copy to `.env` and adjust. docker-compose reads these for the backend service.
# For local (non-docker) runs, set QDRANT_HOST=localhost and
# OLLAMA_BASE_URL=http://localhost:11434.
# ===========================================================================

# --- Vector store (docker uses service name "qdrant") ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Model server (docker uses service name "ollama") ---
OLLAMA_BASE_URL=http://ollama:11434

# --- Embedding provider: ollama | openai | mock ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- LLM provider: ollama | openai | mock ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

# --- Cloud fallback (only used when *_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_EMBED_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small
LLM_BASE_URL=https://api.openai.com/v1

# --- Optional shared API key (leave empty to keep the API open) ---
API_KEY=

# --- Tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=5
